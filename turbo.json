{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "arche#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@arche-ai/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@arche-ai/telegram-bot#typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
